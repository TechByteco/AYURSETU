            "url": {
              "raw": "{{baseUrl}}/api/logbook/log_001/approve",
              "host": ["{{baseUrl}}"],
              "path": ["api", "logbook", "log_001", "approve"]
            },
            "description": "Faculty verifies and digitally signs a student procedure."
          }
        },
        {
          "name": "Issue W3C Verifiable Credential",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Certified Panchakarma Practitioner\",\n  \"skills\": [\"skl_vamana_01\", \"skl_virechana_01\", \"skl_basti_01\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/credentials/issue",
              "host": ["{{baseUrl}}"],
              "path": ["api", "credentials", "issue"]
            },
            "description": "Generate cryptographically signed W3C Verifiable Credential token."
          }
        },
        {
          "name": "Public Cryptographic Verification",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/credentials/verify?token=sample_token_here",
              "host": ["{{baseUrl}}"],
              "path": ["api", "credentials", "verify"],
              "query": [
                {
                  "key": "token",
                  "value": "sample_token_here"
                }
              ]
            },
            "description": "Public instant verification validating HMAC-SHA256 signature and tamper check."
          }
        }
      ]
