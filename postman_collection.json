            "body": {
              "mode": "raw",
              "raw": "{\n  \"procedureName\": \"Kati Vasti (Lumbosacral Oil Pooling)\",\n  \"domain\": \"Panchakarma\",\n  \"doapLevel\": \"PERFORM\",\n  \"patientRef\": \"PT-2026-089\",\n  \"diagnosis\": \"Kativata (Lumbar Spondylosis)\",\n  \"notes\": \"Prepared medicated dough ring using Masha churna. Maintained Sahacharadi taila temperature for 30 minutes.\",\n  \"phiDeclaration\": true\n}"
