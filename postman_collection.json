          "name": "Approve Procedure (Faculty)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"approved\": true,\n  \"feedback\": \"Good oil temperature control observed during procedure.\"\n}"
