{
  "info": {
    "name": "AyushSkillBridge API Collection (SIH26044)",
    "_postman_id": "ayush-skill-bridge-sih2026-coll",
    "description": "Comprehensive API collection for AyushSkillBridge (Smart India Hackathon 2026 - Problem Statement SIH26044: Ministry of Ayush - AIIA)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "aiUrl",
      "value": "http://127.0.0.1:8001",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication & Sessions",
      "item": [
        {
          "name": "Get Current Session & Active Persona",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/session",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "session"]
            },
            "description": "Returns current logged in user and active persona details."
          }
        },
        {
          "name": "Switch Persona (Student / Recruiter / Faculty / Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"persona\": \"recruiter_dabur\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/session",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "session"]
            },
            "description": "Switch persona cookie to simulate different stakeholders."
          }
        },
        {
          "name": "Mock ABHA ID Verification",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"abhaId\": \"91-4521-8890-1234\",\n  \"otp\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/mock-abha",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "mock-abha"]
            },
            "description": "Validate 14-digit ABHA number with mock OTP verification."
          }
        }
      ]
    },
    {
      "name": "2. Skills & Roles Ontologies",
      "item": [
        {
          "name": "Get All Skills Catalog",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/skills?domain=Panchakarma",
              "host": ["{{baseUrl}}"],
              "path": ["api", "skills"],
              "query": [
                {
                  "key": "domain",
                  "value": "Panchakarma",
                  "description": "Filter by domain (e.g. Clinical, Panchakarma, Pharmacognosy)"
                }
              ]
            },
            "description": "List all 75 standardized Ayush skills with optional domain filter."
          }
        },
        {
          "name": "Get Role Ontologies & Weights",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/roles",
              "host": ["{{baseUrl}}"],
              "path": ["api", "roles"]
            },
            "description": "List 16 industry role benchmarks with required skill vectors."
          }
        },
        {
          "name": "Submit Adaptive Assessment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"answers\": [\n    {\n      \"questionId\": \"q1_panchakarma\",\n      \"selectedOption\": 1,\n      \"skillId\": \"skl_vamana_01\",\n      \"domain\": \"Panchakarma\",\n      \"score\": 85\n    },\n    {\n      \"questionId\": \"q2_nadi\",\n      \"selectedOption\": 0,\n      \"skillId\": \"skl_nadi_01\",\n      \"domain\": \"Clinical\",\n      \"score\": 80\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/assessment/submit",
              "host": ["{{baseUrl}}"],
              "path": ["api", "assessment", "submit"]
            },
            "description": "Submit question answers, update student skill vector, and receive recommended roles."
          }
        },
        {
          "name": "Run Gap Analysis for Target Role",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roleId\": \"role_ayush_clin_spec\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/gap-analysis",
              "host": ["{{baseUrl}}"],
              "path": ["api", "gap-analysis"]
            },
            "description": "Compute radar matrix, cosine match score, and structured learning roadmap."
          }
        }
      ]
    },
    {
      "name": "3. Opportunities & Applications",
      "item": [
        {
          "name": "List Opportunities with Match Scores",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/opportunities?type=INTERNSHIP&remote=false",
              "host": ["{{baseUrl}}"],
              "path": ["api", "opportunities"],
              "query": [
                {
                  "key": "type",
                  "value": "INTERNSHIP"
                },
                {
                  "key": "remote",
                  "value": "false"
                }
              ]
            },
            "description": "Search opportunities with domain, remote, and stipend filters."
          }
        },
        {
          "name": "Get Opportunity Details",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/opportunities/opp_001",
              "host": ["{{baseUrl}}"],
              "path": ["api", "opportunities", "opp_001"]
            },
            "description": "Get single opportunity by ID including required skill breakdown."
          }
        },
        {
          "name": "Post New Opportunity (Recruiter)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Clinical Research Intern - Ayush Clinical Trials\",\n  \"description\": \"Assist in Phase II/III Ayurvedic clinical trials in compliance with GCP and ICMR guidelines.\",\n  \"type\": \"INTERNSHIP\",\n  \"domain\": \"Research\",\n  \"nsqfLevel\": 7,\n  \"stipend\": 25000,\n  \"location\": \"New Delhi\",\n  \"remote\": false,\n  \"durationMonths\": 6,\n  \"requiredSkills\": [\n    {\"skillId\": \"skl_gcp_01\", \"name\": \"Good Clinical Practice in Ayush\", \"weight\": 1.0, \"minLevel\": 3},\n    {\"skillId\": \"skl_data_01\", \"name\": \"Ayush Clinical Documentation\", \"weight\": 0.8, \"minLevel\": 3}\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/opportunities",
              "host": ["{{baseUrl}}"],
              "path": ["api", "opportunities"]
            },
            "description": "Post a new opening with NSQF Level and required competencies."
          }
        },
        {
          "name": "List Applications (Student or Recruiter)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/applications",
              "host": ["{{baseUrl}}"],
              "path": ["api", "applications"]
            },
            "description": "List applications submitted by student, or candidates for recruiter's posts."
          }
        },
        {
          "name": "Submit Application with Skill Passport",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"opportunityId\": \"opp_001\",\n  \"coverNote\": \"I am a final year BAMS student at AIIA with extensive clinical DOAP logbook entries in Panchakarma.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/applications",
              "host": ["{{baseUrl}}"],
              "path": ["api", "applications"]
            },
            "description": "Apply to an opportunity with current student skill vector snapshot."
          }
        },
        {
          "name": "Update Application Status (Shortlist / Offer)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"SHORTLISTED\",\n  \"feedback\": \"Candidate displays strong Panchakarma procedural proficiency.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/applications/app_001",
              "host": ["{{baseUrl}}"],
              "path": ["api", "applications", "app_001"]
            },
            "description": "Recruiter moves application through pipeline states."
          }
        }
      ]
    },
    {
      "name": "4. CBME e-Logbook & Digital Credentials",
      "item": [
        {
          "name": "Get Student e-Logbook Entries",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/logbook",
              "host": ["{{baseUrl}}"],
              "path": ["api", "logbook"]
