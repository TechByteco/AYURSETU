            "url": {
              "raw": "{{baseUrl}}/api/logbook",
              "host": ["{{baseUrl}}"],
              "path": ["api", "logbook"]
            },
            "description": "Log a clinical procedure with mandatory PHI de-identification declaration."
          }
        },
